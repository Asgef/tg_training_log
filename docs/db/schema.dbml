Project training_log_bot {
  database_type: "PostgreSQL"
  Note: "2 уровня абстракции: muscle_zones <-> muscles (M:N). Machines размечаются зонами и/или мышцами. SetEntries имеют snapshot зон/мышц."
}

/* -----------------------
   USERS
------------------------*/

Table users {
  id bigint [pk] // можно генерить как snowflake/sequence
  telegram_id bigint [not null, unique]
  telegram_username text
  telegram_firstname text
  telegram_lastname text
  is_registered boolean [not null, default: false]

  // Google Sheets (опционально)
  google_sheet_url text
  spreadsheet_id text

  timezone text [not null, default: "Europe/Moscow"]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (telegram_id) [unique]
    (is_registered)
    (created_at)
  }
}

/* -----------------------
   REFERENCE: MUSCLES + ZONES
   (только 2 уровня: зона и мышца)
------------------------*/

Table muscle_zones {
  id int [pk, increment]
  name text [not null, unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (name) [unique]
  }
}

Table muscles {
  id int [pk, increment]
  name text [not null, unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (name) [unique]
  }
}

/* зона <-> мышцы (M:N) */
Table muscle_zone_muscles {
  zone_id int [not null, ref: > muscle_zones.id]
  muscle_id int [not null, ref: > muscles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (zone_id, muscle_id) [pk]
    (zone_id)
    (muscle_id)
  }
}

/* -----------------------
   MACHINES (оставляем как просил)
------------------------*/

Table machines {
  id int [pk, increment]
  user_id bigint [not null, ref: > users.id]
  name text [not null]
  photo_file_id text
  is_archived boolean [not null, default: false]
  library_machine_id int [ref: > machine_library.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id)
    (is_archived)
    (created_at)
    (library_machine_id)
  }
}

/* Разметка тренажёра зонами (можно выбирать зоны, не углубляясь в мышцы) */
Table machine_zones {
  machine_id int [not null, ref: > machines.id]
  zone_id int [not null, ref: > muscle_zones.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (machine_id, zone_id) [pk]
    (machine_id)
    (zone_id)
  }
}

/* Разметка тренажёра мышцами (точная разметка) */
Table machine_muscles {
  machine_id int [not null, ref: > machines.id]
  muscle_id int [not null, ref: > muscles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (machine_id, muscle_id) [pk]
    (machine_id)
    (muscle_id)
  }
}

/* -----------------------
   MACHINE LIBRARY (библиотека тренажёров)
------------------------*/

Table machine_library {
  id int [pk, increment]
  name_ru text [not null, unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (name_ru) [unique]
    (created_at)
  }
}

Table machine_library_aliases {
  id int [pk, increment]
  machine_library_id int [not null, ref: > machine_library.id]
  alias text [not null, unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (machine_library_id)
    (alias) [unique]
  }
}

Table machine_library_zones {
  machine_library_id int [not null, ref: > machine_library.id]
  zone_id int [not null, ref: > muscle_zones.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (machine_library_id, zone_id) [pk]
    (machine_library_id)
    (zone_id)
  }
}

Table machine_library_muscles {
  machine_library_id int [not null, ref: > machine_library.id]
  muscle_id int [not null, ref: > muscles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (machine_library_id, muscle_id) [pk]
    (machine_library_id)
    (muscle_id)
  }
}

/* -----------------------
   WORKOUT SESSIONS
------------------------*/

Table workout_sessions {
  id int [pk, increment]
  user_id bigint [not null, ref: > users.id]

  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id)
    (started_at)
    (ended_at)
  }
}

/* -----------------------
   SET ENTRIES (подходы)
------------------------*/

Table set_entries {
  id int [pk, increment]

  session_id int [not null, ref: > workout_sessions.id]
  machine_id int [not null, ref: > machines.id]

  weight numeric(6,2) [not null]  // 9999.99 хватит с запасом
  reps int [not null]
  rir int [not null, default: 2, note: "0..5 (0 = отказ)"]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (session_id)
    (machine_id)
    (created_at)
  }

  Note: "CHECK (rir >= 0 AND rir <= 5)"
}

/* -----------------------
   SNAPSHOT
   фиксируем зоны/мышцы НА МОМЕНТ подхода
------------------------*/

Table set_entry_zones {
  set_entry_id int [not null, ref: > set_entries.id]
  zone_id int [not null, ref: > muscle_zones.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (set_entry_id, zone_id) [pk]
    (set_entry_id)
    (zone_id)
  }
}

Table set_entry_muscles {
  set_entry_id int [not null, ref: > set_entries.id]
  muscle_id int [not null, ref: > muscles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (set_entry_id, muscle_id) [pk]
    (set_entry_id)
    (muscle_id)
  }
}

/* -----------------------
   Telegram idempotency (НЕ УДАЛЯТЬ)
------------------------*/

Table processed_updates {
  Note: "Идемпотентность: обработанные Telegram update_id"
  update_id bigint [pk]
  processed_at timestamptz [not null, default: `now()`]

  Indexes {
    (processed_at)
  }
}
